menuconfig PRECISION_TIMING
	bool "Precision timing infrastructure"
	depends on SYS_CLOCK_EXISTS
	help
	  Enable protocol-neutral precision timing helpers for domain-qualified
	  timestamps, clock adapters, mappings, and clock discipline.

	  The API is at experimental maturity as described by the Zephyr API
	  lifecycle, so it may still change. The subsystem is a building block
	  for protocols such as PTP and gPTP and does not change their maturity.

if PRECISION_TIMING

config PRECISION_TIMING_PI_KP
	int "PI clock discipline proportional gain in thousandths"
	default 700
	range 0 10000
	help
	  Proportional gain used by the precision timing PI clock discipline,
	  expressed in thousandths. For example, 700 configures a gain of 0.7.

	  The default is suitable for a synchronization interval around one
	  second. Shorter intervals may require a smaller gain to avoid
	  oscillation.

config PRECISION_TIMING_PI_KI
	int "PI clock discipline integral gain in thousandths"
	default 300
	range 0 10000
	help
	  Integral gain used by the precision timing PI clock discipline,
	  expressed in thousandths. For example, 300 configures a gain of 0.3.

	  The default is suitable for a synchronization interval around one
	  second. Shorter intervals may require a smaller gain to avoid
	  oscillation.

config PRECISION_SOFTWARE_CLOCK
	bool "Adjustable software precision clock"
	depends on MULTITHREADING
	help
	  Enable a caller-owned adjustable software clock backed by a stable
	  64-bit system cycle counter when available, with kernel uptime ticks as
	  a portable fallback. The clock is independent of SYS_CLOCK_REALTIME and
	  supports explicit set, phase, and parts-per-billion rate adjustments.

config PRECISION_CLOCK_SYNC_SERVICE
	bool "Precision clock synchronization service"
	depends on MULTITHREADING
	help
	  Enable caller-owned fixed-clock synchronization instances that sample a
	  source clock, discipline an exclusively owned sink clock, and publish
	  lifecycle and synchronization diagnostics.

config PRECISION_TIMING_SHELL
	bool "Precision timing shell"
	depends on SHELL
	help
	  Enable a runtime registry and shell commands for inspecting precision
	  clocks. When the precision clock synchronization service is enabled,
	  registered synchronization instances can also be started, stopped,
	  reset, and inspected.

config PRECISION_TIMING_SHELL_MAX_INSTANCES
	int "Maximum number of precision timing shell instances"
	default 4
	range 1 16
	depends on PRECISION_TIMING_SHELL
	help
	  Set the fixed capacity of the precision timing shell registry.

endif # PRECISION_TIMING
